# Main Robot Controller System (No 'fan motor' declared)
Robot {
  translation 0.55 0.95 0.55
  children [
    Display {
      name "scada_display"
      width 320
      height 180
    }
    # Baseplate
    Pose {
      translation 0 0 -0.15
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.20 0.22 0.25
            roughness 0.6
            metalness 0.8
          }
          geometry Box {
            size 0.45 0.65 0.04
          }
        }
      ]
    }
    # Reduction Gearbox
    Pose {
      translation -0.18 0 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.35 0.38
            roughness 0.4
            metalness 0.65
          }
          geometry Box {
            size 0.16 0.22 0.20
          }
        }
      ]
    }
    # Motor Stator Casing & Ribbed Fins
    Pose {
      translation 0.08 0 0
      children [
        Pose {
          rotation 0 1 0 1.5708
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.18 0.38 0.42
                roughness 0.4
                metalness 0.65
              }
              geometry Cylinder {
                height 0.30
                radius 0.11
              }
            }
          ]
        }
        # Terminal Junction Box
        Pose {
          translation 0.02 0 0.14
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.15 0.20 0.24
                roughness 0.5
                metalness 0.7
              }
              geometry Box {
                size 0.09 0.09 0.05
              }
            }
          ]
        }
      ]
    }
    # Primary Actuator
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor -0.28 0 0
      }
      device [
        RotationalMotor {
          name "rotational motor"
          maxVelocity 20
        }
      ]
      endPoint Solid {
        translation -0.28 0 0
        rotation 0 1 0 1.5708
