#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  info [
    "High-Fidelity Cyber-Physical Safety Interlock & SCADA Simulation",
    "HARDWARE FAULT-TOLERANCE DEMO WORLD: 'fan motor' is intentionally omitted.",
    "The supervisor controller must run seamlessly in fallback convective triage without crashing.",
    "Supervisor Controller: esd_supervisor_controller",
    "Subsystems: 3-Phase Induction Drive Motor, Conveyor Belt System, 3-Tier Andon Stack Light"
  ]
  title "Industrial Manufacturing Plant - Fault Tolerance Demo (No Fan)"
  basicTimeStep 64
}

Viewpoint {
  orientation -0.324 0.348 0.880 2.245
  position 1.95 -2.05 1.55
}

TexturedBackground {
}

TexturedBackgroundLight {
}

DirectionalLight {
  direction -0.55 -0.45 -1.0
  intensity 1.4
  castShadows TRUE
}

SpotLight {
  attenuation 1 0 0
  beamWidth 1.2
  cutOffAngle 1.6
  direction 0 0 -1
  intensity 4.5
  location 0.2 0 3.2
  castShadows TRUE
}

PointLight {
  attenuation 1 0 0
  intensity 2.2
  location -1.5 1.5 2.2
}

